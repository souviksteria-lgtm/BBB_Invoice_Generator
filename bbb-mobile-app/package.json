  "author": "Baisakhi",
  "license": "ISC",
  "devDependencies": {
    "cordova": "^12.0.0",
    "cordova-android": "^13.0.0",
    "cordova-plugin-file": "^8.0.0",
    "cordova-plugin-whitelist": "^1.3.3"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-whitelist": {},
      "cordova-plugin-file": {},
      "cordova-plugin-x-socialsharing": {},
